# =============================================
# Configuration du Jeu de l'Imitation
# =============================================

# Clé API Groq (gratuit)
# Obtenez votre clé sur: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================
# INSTRUCTIONS DE DÉPLOIEMENT
# =============================================
#
# 1. Créez un compte gratuit sur https://console.groq.com
# 2. Générez une clé API dans "API Keys"
# 3. Dans Vercel, ajoutez la variable d'environnement:
#    - Allez dans Settings > Environment Variables
#    - Ajoutez GROQ_API_KEY avec votre clé
# 4. Redéployez l'application
#
# Le modèle utilisé est llama-3.1-8b-instant (gratuit et rapide)
# Limite gratuite: ~30 requêtes/minute
# =============================================
